[user]
	name = Sam Dhondt
	email = sam.dhondt@codifly.be
[core]
	excludesfile = /Users/sam/.gitignore_global
	ignorecase = false
	editor = nvim
  pager = less
[mergetool "nvim"]
  cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[alias]
	co = checkout
	ci = commit
  cs = commit -vsS 
	st = status
	br = branch
  rb = rebase
  pl = pull
  ps = push
[commit]
  verbose = true
  gpgsign = true
[diff]
	tool = less
[merge]
	tool = nvim
[push]
	default = current
[difftool]
	prompt = false
[pull]
	rebase = true
[rebase]
	autoStash = true
[rerere]
  enabled = true
[log]
  follow = true
[gpg]
	program = gpg
[pull]
	ff = only
	rebase = true
[rebase]
	autoStash = true
