[user]
	name = Sam Dhondt
	email = sam.dhondt@codifly.be
  signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIONo9UvBVRI/nP0j+ey+hTzepWaPiRU7zfo4cBjCW+Be
[core]
	excludesfile = /Users/sam/.gitignore_global
	ignorecase = false
	editor = nvim
  pager = less
[mergetool "nvim"]
  cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"
[alias]
	co = checkout
	ci = commit
  cs = commit -vsS 
	st = status
	br = branch
  rb = rebase
  pl = pull
  ps = push
[commit]
  verbose = true
  gpgsign = true
[diff]
	tool = less
[merge]
	tool = nvim
[push]
	default = current
[difftool]
	prompt = false
[pull]
	rebase = true
[rebase]
	autoStash = true
	autoSquash = true
[rerere]
  enabled = true
[log]
  follow = true
[gpg]
  format = ssh
[gpg "ssh"]
  program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  allowedSignersFile = "~/.ssh/allowed_signers"
